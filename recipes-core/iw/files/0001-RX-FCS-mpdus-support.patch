From 18dd655f6a3db728f19d3ea443dbba8093c0cff8 Mon Sep 17 00:00:00 2001
From: Ming Jiang <quic_mjiang@quicinc.com>
Date: Mon, 5 Dec 2022 15:09:10 +0800
Subject: [PATCH] RX FCS mpdus support

Upstream-Status: Pending
Signed-off-by: Ming Jiang <quic_mjiang@quicinc.com>
---
 station.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/station.c b/station.c
index b2c5b9c..7293bff 100644
--- a/station.c
+++ b/station.c
@@ -332,6 +332,12 @@ static void print_nested_sta_handler(struct nlattr *link_sinfo[NL80211_STA_INFO_MAX + 1],
 	else if (link_sinfo[NL80211_STA_INFO_RX_BYTES])
 		printf("%srx bytes:\t%u", indent,
 		       nla_get_u32(link_sinfo[NL80211_STA_INFO_RX_BYTES]));
+	if (link_sinfo[NL80211_STA_INFO_RX_MPDUS])
+		printf("%srx mpdus:\t%u", indent,
+			nla_get_u32(link_sinfo[NL80211_STA_INFO_RX_MPDUS]));
+	if (link_sinfo[NL80211_STA_INFO_FCS_ERROR_COUNT])
+		printf("%srx fcs error count:\t%u", indent,
+			nla_get_u32(link_sinfo[NL80211_STA_INFO_FCS_ERROR_COUNT]));
 	if (link_sinfo[NL80211_STA_INFO_RX_PACKETS])
 		printf("%srx packets:\t%u", indent,
 			nla_get_u32(link_sinfo[NL80211_STA_INFO_RX_PACKETS]));
@@ -463,6 +469,8 @@ static int print_sta_handler(struct nl_msg *msg, void *arg)
 	static struct nla_policy stats_policy[NL80211_STA_INFO_MAX + 1] = {
 		[NL80211_STA_INFO_INACTIVE_TIME] = { .type = NLA_U32 },
 		[NL80211_STA_INFO_RX_BYTES] = { .type = NLA_U32 },
+		[NL80211_STA_INFO_FCS_ERROR_COUNT] = { .type = NLA_U32 },
+		[NL80211_STA_INFO_RX_MPDUS] = { .type = NLA_U32 },
 		[NL80211_STA_INFO_TX_BYTES] = { .type = NLA_U32 },
 		[NL80211_STA_INFO_RX_BYTES64] = { .type = NLA_U64 },
 		[NL80211_STA_INFO_TX_BYTES64] = { .type = NLA_U64 },

-- 
