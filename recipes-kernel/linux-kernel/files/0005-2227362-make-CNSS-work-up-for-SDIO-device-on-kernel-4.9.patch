+#include <crypto/skcipher.h>
 
 /* APIs for calling crypto routines from kernel
  */
@@ -42,22 +43,22 @@ int wcnss_wlan_crypto_ahash_setkey(struct crypto_ahash *tfm, const u8 *key,
