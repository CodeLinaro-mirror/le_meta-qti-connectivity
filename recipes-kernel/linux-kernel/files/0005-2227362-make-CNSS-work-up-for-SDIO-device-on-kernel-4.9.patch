 	struct device *dev = &cnss_pdata->pdev->dev;
 
@@ -1383,7 +1438,7 @@ static int cnss_sdio_init_bus_bandwidth(void)
 		dev_err(dev, "Failed to register with bus_scale client\n");
 		ret = -EINVAL;
 	}
-
+#endif
 	return ret;
 }
 
