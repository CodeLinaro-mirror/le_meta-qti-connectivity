+#endif
 {
 	struct cnss_sdio_info *cnss_info;
 	struct cnss_sdio_wlan_driver *wdrv;
@@ -355,7 +373,11 @@ static int cnss_sdio_shutdown(const struct subsys_desc *subsys, bool force_stop)
 	return ret;
