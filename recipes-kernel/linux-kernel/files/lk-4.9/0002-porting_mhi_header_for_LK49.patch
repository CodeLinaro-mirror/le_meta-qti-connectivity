@@ -1,6 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0 */
 #ifndef __LINUX_CORESIGHT_STM_H_
 #define __LINUX_CORESIGHT_STM_H_
-
+#include <asm/local.h>
+#include <linux/stm.h>
