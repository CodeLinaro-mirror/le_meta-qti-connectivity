From a3fbf5f177e1e2a5d5492cddfb2241fc266193d1 Mon Sep 17 00:00:00 2001
From: Zhaoyang Liu <quic_zhaoyang@quicinc.com>
Date: Tue, 4 Jan 2022 13:30:16 +0800
Subject: [PATCH] dts: add device tree changes to support hsp

---
 .../boot/dts/freescale/imx8-ss-hsio.dtsi      | 27 +++++++++++++++++++
 arch/arm64/boot/dts/freescale/imx8mq.dtsi     | 26 ++++++++++++++++++
 2 files changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8-ss-hsio.dtsi b/arch/arm64/boot/dts/freescale/imx8-ss-hsio.dtsi
index c6629e048777..588b7efc399e 100644
--- a/arch/arm64/boot/dts/freescale/imx8-ss-hsio.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8-ss-hsio.dtsi
@@ -90,6 +90,11 @@ misc_crr5_lpcg: clock-controller@5f0f0000 {
 		power-domains = <&pd IMX_SC_R_HSIO_GPIO>;
 	};
 
+	mhi: qcom,mhi {
+		compatible = "qcom,mhi";
+		status = "okay";
+	};
+
 	pcieb: pcie@0x5f010000 {
 		compatible = "fsl,imx8qm-pcie","snps,dw-pcie";
 		reg = <0x5f010000 0x10000>, /* Controller reg */
@@ -161,4 +166,26 @@ pcieb_ep: pcie_ep@0x5f010000 {
 		num-ob-windows = <6>;
 		status = "disabled";
 	};
+
+	ipc_router: qcom,ipc_router_external_modem_xprt2 {
+		compatible = "qcom,ipc_router_mhi_xprt";
+		qcom,ch-name = "IPCRTR";
+		qcom,out-chan-id = <20>;
+		qcom,in-chan-id = <21>;
+		qcom,xprt-remote = "external-wlan";
+		qcom,xprt-linkid = <1>;
+		qcom,xprt-version = <3>;
+		status = "okay";
+	};
+
+	diag_mhi: qcom,diag-mhi {
+		compatible = "qcom,diag-mhi";
+		status = "okay";
+	};
+
+	cnss2: qcom,cnss-qca6490 {
+		compatible = "qcom,cnss-qca6490";
+		status = "okay";
+	};
+
 };
diff --git a/arch/arm64/boot/dts/freescale/imx8mq.dtsi b/arch/arm64/boot/dts/freescale/imx8mq.dtsi
index 4071063d618c..9de7beecf46a 100755
--- a/arch/arm64/boot/dts/freescale/imx8mq.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mq.dtsi
@@ -1489,6 +1489,11 @@ gpmi: gpmi-nand@33002000{
 			status = "disabled";
 		};
 
+		mhi: qcom,mhi {
+			compatible = "qcom,mhi";
+			status = "okay";
+		};
+
 		pcie0: pcie@33800000 {
 			compatible = "fsl,imx8mq-pcie";
 			reg = <0x33800000 0x400000>,
@@ -1602,6 +1607,27 @@ gic: interrupt-controller@38800000 {
 			interrupt-parent = <&gic>;
 		};
 
+		ipc_router: qcom,ipc_router_external_modem_xprt2 {
+			compatible = "qcom,ipc_router_mhi_xprt";
+			qcom,ch-name = "IPCRTR";
+			qcom,out-chan-id = <20>;
+			qcom,in-chan-id = <21>;
+			qcom,xprt-remote = "external-wlan";
+			qcom,xprt-linkid = <1>;
+			qcom,xprt-version = <3>;
+			status = "okay";
+		};
+
+		diag_mhi: qcom,diag-mhi {
+			compatible = "qcom,diag-mhi";
+			status = "okay";
+		};
+
+		cnss2: qcom,cnss-qca6490 {
+			compatible = "qcom,cnss-qca6490";
+			status = "okay";
+		};
+
 		ddrc: memory-controller@3d400000 {
 			compatible = "fsl,imx8mq-ddrc", "fsl,imx8m-ddrc";
 			reg = <0x3d400000 0x400000>;
-- 
2.25.1

