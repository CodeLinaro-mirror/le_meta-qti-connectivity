From bb7e8b7e394a40261ff2716abcaf99614c6a9100 Mon Sep 17 00:00:00 2001
From: Xueqiang Gong <quic_gongx@quicinc.com>
Date: Tue, 11 Apr 2023 14:54:09 +0800
Subject: [PATCH] update dts to add 32k sleep clock at imx8qxpmek

Change-Id: I5345afc69b0537e843f5c53c328273ba03403f99
Signed-off-by: Xueqiang Gong <quic_gongx@quicinc.com>
---
 arch/arm64/boot/dts/freescale/Makefile                 |  1 +
 arch/arm64/boot/dts/freescale/imx8qxp-32k-support.dtsi | 11 +++++++++++
 arch/arm64/boot/dts/freescale/imx8qxp-mek.dts          |  1 +
 3 files changed, 13 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8qxp-32k-support.dtsi

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index ccd099d..806651e 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -337,6 +337,7 @@
 dtb-$(CONFIG_ARCH_MXC) += imx8mm-venice-gw73xx-0x-rs422.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mm-venice-gw73xx-0x-rs485.dtb
 dtb-$(CONFIG_ARCH_MXC) += qc-cnss.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx8qxp-32k-support.dtb
 dtb-$(CONFIG_ARCH_S32) += s32g274a-evb.dtb
 dtb-$(CONFIG_ARCH_S32) += s32g274a-rdb2.dtb
 dtb-$(CONFIG_ARCH_S32) += s32v234-evb.dtb \
diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-32k-support.dtsi b/arch/arm64/boot/dts/freescale/imx8qxp-32k-support.dtsi
new file mode 100644
index 00000000..56aaeee
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-32k-support.dtsi
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2023 Qualcomm Innovation Center, Inc. All rights reserved.
+*/
+ / {
+
+	cnss_pcie: qcom,cnss-qca-converged {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi>;
+	
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts b/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
index 47cf994..0f158c0 100644
--- a/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
@@ -8,6 +8,7 @@
 #include "imx8qxp.dtsi"
 #include "imx8x-mek.dtsi"
 #include "qc-cnss.dts"
+#include "imx8qxp-32k-support.dtsi"
 
 / {
 	model = "Freescale i.MX8QXP MEK";
-- 
2.7.4

