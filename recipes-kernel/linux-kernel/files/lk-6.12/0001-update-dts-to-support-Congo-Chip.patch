From bfa38df0fe452d5bd4f2374c968811c01eeea2ff Mon Sep 17 00:00:00 2001
From: gongx <gongx@qti.qualcomm.com>
Date: Wed, 6 May 2026 17:06:03 +0800
Subject: [PATCH] update dts to support Congo Chip

Upstream-Status: Pending
Signed-off-by: Xueqiang Gong <gongx@qti.qualcomm.com>
---
 arch/arm64/boot/dts/freescale/imx8x-mek.dtsi | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi b/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
index adf8a456651d..bb0db181eef9 100644
--- a/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
@@ -17,6 +17,24 @@ brcmfmac: brcmfmac {
 		pinctrl-2 = <&pinctrl_wifi>;
 	};
 
+	cnss_pcie: qcom,cnss-fig {
+		compatible = "qcom,cnss-fig";
+		supported-ids = <0x1111>;
+		qcom,wlan;
+		qcom,wlan-rc-num = <0>;
+		qcom,bus-type=<0>;
+		qcom,wlan-ramdump-dynamic = <0x780000>;
+		
+		cnss-enable-self-recovery;
+		use-pm-domain;
+		qcom,same-dt-multi-dev;
+		cx-mode = <0>;
+		power-ctrl-mode = <2>;
+		
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi>;
+	};
+	
 	lvds_backlight0: lvds-backlight-0 {
 		compatible = "pwm-backlight";
 		pwms = <&pwm_mipi_lvds0 0 100000 0>;
-- 
2.34.1

