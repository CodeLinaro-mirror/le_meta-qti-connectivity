From 7b46a54947d759dc817bc9ac05332b3bc91deb35 Mon Sep 17 00:00:00 2001
From: Xueqiang Gong <gongx@qti.qualcomm.com>
Date: Wed, 10 Sep 2025 16:15:14 +0800
Subject: [PATCH] kernel: fix the issue "ttyLP1" is missed if QC BT is used

Upstream-Status: Pending
Signed-off-by: Xueqiang Gong <gongx@qti.qualcomm.com>
---
 arch/arm64/boot/dts/freescale/imx8x-mek.dtsi | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi b/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
index 2dc3872c4930..f2a293ae4c0c 100644
--- a/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
@@ -1010,10 +1010,6 @@ &lpuart1 {
        pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_lpuart1>;
 	status = "okay";
-
-	bluetooth {
-		compatible = "nxp,88w8987-bt";
-	};
 };
 
 &lpuart2 {
