From 6b27a639dc02481dd77fece01fa9c967692614e0 Mon Sep 17 00:00:00 2001
From: mingjian <mingjian@qti.qualcomm.com>
Date: Wed, 10 Sep 2025 16:41:07 +0800
Subject: [PATCH] Add configuration support for BT I2S slave/master

Upstream-Status: Pending
Signed-off-by: mingjian <mingjian@qti.qualcomm.com>
---
 arch/arm64/boot/dts/freescale/imx8x-mek.dtsi |  2 ++
 sound/soc/fsl/fsl_sai.c                      | 12 ++++++++++++
 2 files changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi b/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
index f2a293ae4c0c..7aeedd90994b 100644
--- a/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8x-mek.dtsi
@@ -739,6 +739,8 @@ &sai0 {
 	assigned-clock-rates = <786432000>, <49152000>, <12288000>, <49152000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_sai0>;
+        fsl,txmasterflag=<1>;
+        fsl,rxmasterflag=<1>;
 	status = "okay";
 };
 
diff --git a/sound/soc/fsl/fsl_sai.c b/sound/soc/fsl/fsl_sai.c
index 3a353de3efc5..3c542071f4ef 100644
--- a/sound/soc/fsl/fsl_sai.c
+++ b/sound/soc/fsl/fsl_sai.c
@@ -1486,6 +1486,18 @@ static int fsl_sai_probe(struct platform_device *pdev)
                return ret;
        }
 
+       if (of_find_property(np, "fsl,txm-rxs", NULL) != NULL) {
+               sai->masterflag[FSL_FMT_TRANSMITTER] = SND_SOC_DAIFMT_BP_FP;
+               sai->masterflag[FSL_FMT_RECEIVER] = SND_SOC_DAIFMT_BC_FC;
+	}else {
+		if (!of_property_read_u32(np, "fsl,txmasterflag",
+			&sai->masterflag[FSL_FMT_TRANSMITTER]))
+			sai->masterflag[FSL_FMT_TRANSMITTER] <<= 12;
+		if (!of_property_read_u32(np, "fsl,rxmasterflag",
+			&sai->masterflag[FSL_FMT_RECEIVER]))
+			sai->masterflag[FSL_FMT_RECEIVER] <<= 12;
+       }
+
 	irq = platform_get_irq(pdev, 0);
        if (irq < 0)
                return irq;
-- 
2.34.1

