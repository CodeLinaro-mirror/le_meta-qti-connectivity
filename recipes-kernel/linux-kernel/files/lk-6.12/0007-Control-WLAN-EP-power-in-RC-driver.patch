diff --git a/drivers/pci/controller/dwc/pci-imx6.c b/drivers/pci/controller/dwc/pci-imx6.c
index c87b0392b8d9..361c762b05af 100644
--- a/drivers/pci/controller/dwc/pci-imx6.c
+++ b/drivers/pci/controller/dwc/pci-imx6.c
@@ -36,7 +36,7 @@
 #include <linux/pm_runtime.h>
 
 #include "pcie-designware.h"
-
+#include "pcie-ep-power.h"
 #define IMX95_PCIE2_BASE_ADDR			0x4c380000
 #define IMX95_PCIE_PHY_GEN_CTRL			0x0
 #define IMX95_PCIE_REF_USE_PAD			BIT(17)
@@ -1771,6 +1771,13 @@ static int imx6_pcie_suspend_noirq(struct device *dev)
 		imx6_pcie_host_exit(pp);
 	}
 
+	if (gpio_is_valid(imx6_pcie->reset_gpio))
+		gpio_set_value_cansleep(imx6_pcie->reset_gpio,
+					imx6_pcie->gpio_active_high);
+
+#ifdef CONFIG_WLAN_EP_SHUTDOWN
+	wlan_ep_power_off();
+#endif
 	return 0;
 }
 
@@ -1783,6 +1790,9 @@ static int imx6_pcie_resume_noirq(struct device *dev)
 	if (!(imx6_pcie->drvdata->flags & IMX6_PCIE_FLAG_SUPPORTS_SUSPEND))
 		return 0;
 
+#ifdef CONFIG_WLAN_EP_SHUTDOWN
+	wlan_ep_power_on();
+#endif
 	if (unlikely(imx6_pcie->drvdata->variant == IMX6Q)) {
 		/*
 		 * L2 can exit by 'reset' or Inband beacon (from remote EP)
@@ -1805,6 +1815,30 @@ static int imx6_pcie_resume_noirq(struct device *dev)
 
 	return 0;
 }
+/*
+ * @endpoint: pci ep device
+ * @op: positive for suspend link and zero for resume link
+ */
+int platform_rc_pm_control(void *endpoint, int op)
+{
+	struct pci_dev *pci_dev = (struct pci_dev *)endpoint;
+	struct dw_pcie_rp *pp = pci_dev->bus->sysdata;
+	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
+	struct device *dev = pci->dev;
+
+	if (!dev)
+		return -1;
+
+	pr_info("%s dev %p OP %s dev 0x%lx\n",
+		 __func__, dev, op ? "resume":"suspend", (u64)dev);
+	if (op) {
+		imx6_pcie_resume_noirq(dev);
+	} else {
+		imx6_pcie_suspend_noirq(dev);
+	}
+	return 0;
+}
+EXPORT_SYMBOL(platform_rc_pm_control);
 
 static int imx6_pcie_suspend(struct device *dev)
 {
@@ -1876,7 +1910,9 @@ static int imx6_pcie_probe(struct platform_device *pdev)
 	pci = devm_kzalloc(dev, sizeof(*pci), GFP_KERNEL);
 	if (!pci)
 		return -ENOMEM;
-
+#ifdef CONFIG_WLAN_EP_SHUTDOWN
+	wlan_ep_power_init(dev);
+#endif
 	pci->dev = dev;
 	pci->ops = &dw_pcie_ops;
 	pci->pp.ops = &imx6_pcie_host_ops;
@@ -2120,6 +2156,9 @@ static int imx6_pcie_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+#ifdef CONFIG_WLAN_EP_SHUTDOWN
+	wlan_ep_power_on();
+#endif
 	if (imx6_pcie->drvdata->mode == DW_PCIE_EP_TYPE) {
 		ret = imx6_add_pcie_ep(imx6_pcie, pdev);
 		if (ret < 0)
diff --git a/drivers/pci/controller/dwc/pcie-ep-power.c b/drivers/pci/controller/dwc/pcie-ep-power.c
new file mode 100644
index 000000000000..d7d58152de7e
--- /dev/null
+++ b/drivers/pci/controller/dwc/pcie-ep-power.c
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2024 Qualcomm Innovation Center, Inc. All rights reserved.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio.h>
+#include <linux/kernel.h>
+#include <linux/of_gpio.h>
+#include <linux/of_device.h>
+#include <linux/of_address.h>
+#include <linux/types.h>
+#define GPIONAME	"wlan-en-gpio"
+
+struct ep_power {
+	struct device *dev;
+	int wlan_en_gpio;
+	bool power_on;
+};
+
+struct ep_power *epp;
+
+int wlan_ep_power_init(struct device *dev)
+{
+	int ret = 0;
+	struct device_node *node = dev->of_node;
+
+	epp = (struct ep_power *) devm_kzalloc(dev, sizeof(struct ep_power), GFP_KERNEL);
+	if (!epp)
+		return -ENOMEM;
+
+	epp->dev = dev;
+	epp->wlan_en_gpio = of_get_named_gpio(node, GPIONAME, 0);
+	if (gpio_is_valid(epp->wlan_en_gpio)) {
+		ret = devm_gpio_request_one(dev, epp->wlan_en_gpio,
+					    GPIOF_OUT_INIT_LOW, "WLAN EN");
+		if (ret) {
+			dev_err(dev, "unable to get wlan en gpio\n");
+			return ret;
+		}
+	} else {
+		return epp->wlan_en_gpio;
+	}
+
+	return ret;
+}
+
+int wlan_ep_power_on(void)
+{
+	int ret = 0;
+	if (!epp)
+		return -ENOMEM;
+
+	if (!epp->power_on) {
+		gpio_set_value_cansleep(epp->wlan_en_gpio, 1);
+		epp->power_on = true;
+		pr_info("%s wlan power on\n", __func__);
+	}
+	return ret;
+}
+
+int wlan_ep_power_off(void)
+{
+	int ret = 0;
+	if (!epp)
+		return -ENOMEM;
+
+	if (epp->power_on) {
+		gpio_set_value_cansleep(epp->wlan_en_gpio, 0);
+		epp->power_on = false;
+		pr_info("%s wlan power off\n", __func__);
+	}
+	return ret;
+}
diff --git a/drivers/pci/controller/dwc/pcie-ep-power.h b/drivers/pci/controller/dwc/pcie-ep-power.h
