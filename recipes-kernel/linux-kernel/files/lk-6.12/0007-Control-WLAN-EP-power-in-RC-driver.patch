 arch/arm64/boot/dts/freescale/imx8x-mek.dtsi |  1 +
 drivers/pci/controller/dwc/Makefile          |  2 +-
 drivers/pci/controller/dwc/pci-imx6.c        | 43 +++++++++++-
 drivers/pci/controller/dwc/pcie-ep-power.c   | 74 ++++++++++++++++++++
 drivers/pci/controller/dwc/pcie-ep-power.h   |  7 ++
 6 files changed, 124 insertions(+), 4 deletions(-)
 create mode 100644 drivers/pci/controller/dwc/pcie-ep-power.c
 create mode 100644 drivers/pci/controller/dwc/pcie-ep-power.h

