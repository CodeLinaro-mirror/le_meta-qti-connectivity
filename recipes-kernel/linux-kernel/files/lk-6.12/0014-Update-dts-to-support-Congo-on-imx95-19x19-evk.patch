From e0453393d0b674f7051132eda9b0c080bfd86961 Mon Sep 17 00:00:00 2001
From: Dongyuan Li <dongyuan@qti.qualcomm.com>
Date: Fri, 24 Jul 2026 10:28:14 +0800
Subject: [PATCH] Update dts to support Congo with ext clk on imx95-19x19-evk

Upstream-Status: Pending
Change-Id: I586bf8a8ed1aeb36ae54b3934683ffe6ca4a5b9e
Signed-off-by: Dongyuan Li <dongyuan@qti.qualcomm.com>
---
 .../boot/dts/freescale/imx95-19x19-evk.dts    | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts b/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
index ab7bd4fdaadf..94475d3f67b3 100644
--- a/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-19x19-evk.dts
@@ -36,6 +36,30 @@ bt_sco_codec: audio-codec-bt-sco {
 		compatible = "linux,bt-sco";
 	};
 
+	cnss_pcie: qcom,cnss-fig {
+		compatible = "qcom,cnss-fig";
+		supported-ids = <0x1111>;
+		qcom,wlan;
+		qcom,wlan-rc-num = <0>;
+		qcom,bus-type = <0>;
+		qcom,wlan-ramdump-dynamic = <0x780000>;
+
+		cnss-enable-self-recovery;
+		use-pm-domain;
+		qcom,same-dt-multi-dev;
+		cx-mode = <0>;
+		power-ctrl-mode = <2>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi>;
+
+		clocks = <&scmi_clk IMX95_CLK_CCMCKO4>;
+		clock-names = "cko4";
+		assigned-clocks = <&scmi_clk IMX95_CLK_CCMCKO4>;
+		assigned-clock-parents = <&scmi_clk IMX95_CLK_32K>;
+		assigned-clock-rates = <32768>;
+	};
+
 	chosen {
 		stdout-path = &lpuart1;
 		#address-cells = <2>;
@@ -1129,6 +1153,12 @@ IMX95_PAD_GPIO_IO23__SPDIF_OUT				0x31e
 		>;
 	};
 
+	pinctrl_wifi: wificlkgrp {
+		fsl,pins = <
+			IMX95_PAD_CCM_CLKO4__CCMSRCGPCMIX_TOP_CLKO_4		0x31e
+		>;
+	};
+
 	pinctrl_usdhc1: usdhc1grp {
 		fsl,pins = <
 			IMX95_PAD_SD1_CLK__USDHC1_CLK			0x158e
-- 
2.34.1

