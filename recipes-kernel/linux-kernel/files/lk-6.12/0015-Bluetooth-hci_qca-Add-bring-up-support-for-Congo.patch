+/*
+ * qca_peri_set_baudrate - Send SET_BAUDRATE to the peripheral subsystem.
+ *
+ * Follows the same fire-and-forget pattern as qca_set_baudrate(): the command
+ * is queued to txq and we wait for it to be fully transmitted before returning.
+ * We do NOT wait for a CMD_COMPLETE event because the controller switches its
+ * baudrate immediately after receiving the command — the event would be sent
+ * at the new baudrate while the host is still at the old one, so it cannot be
+ * received correctly.
+ */
+static int qca_peri_set_baudrate(struct hci_dev *hdev, uint8_t baudrate)
+{
+	struct hci_uart *hu = hci_get_drvdata(hdev);
+	int ret;
+
+	bt_dev_info(hdev, "QCA peri: SET_BAUDRATE 0x%02x", baudrate);
+
+	/* Queue the SET_BAUDRATE command — fire-and-forget, no CMD_COMPLETE
+	 * wait (same rationale as qca_set_baudrate).
+	 */
+	ret = qca_send_peri_cmd(hu, HCI_VS_PERI_GENERAL_OPCODE,
+				PERI_EDL_CMD_SET_BAUDRATE,
+				false, &baudrate, sizeof(baudrate));
+	if (ret) {
+		bt_dev_err(hdev, "QCA peri: SET_BAUDRATE enqueue failed (%d)",
+			   ret);
+		return ret;
+	}
+
+	/* Wait for the command to be fully transmitted before the host
+	 * switches baudrate (mirrors qca_set_baudrate).
+	 */
+	{
+		struct qca_data *qca = hu->priv;
+
+		while (!skb_queue_empty(&qca->txq))
+			usleep_range(100, 200);
+	}
+
+	if (hu->serdev)
+		serdev_device_wait_until_sent(hu->serdev,
+					      msecs_to_jiffies(CMD_TRANS_TIMEOUT_MS));
+
+	/* Give the controller time to process the baudrate change */
+	msleep(300);
+
+	return 0;
+}
