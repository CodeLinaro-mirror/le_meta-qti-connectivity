From 7b46a54947d759dc817bc9ac05332b3bc91deb35 Mon Sep 17 00:00:00 2001
From: Xueqiang Gong <gongx@qti.qualcomm.com>
Date: Wed, 10 Sep 2025 16:15:14 +0800
Subject: [PATCH] kernel: fix the issue "ttyLP1" is missed if QC BT is used

Upstream-Status: Pending
Signed-off-by: Xueqiang Gong <gongx@qti.qualcomm.com>
---
 arch/arm64/boot/dts/freescale/imx8qxp-mek.dts | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts b/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
index 965a92258248..b7b3955f8b79 100644
--- a/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
@@ -968,10 +968,6 @@ &lpuart1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_lpuart1>;
 	status = "okay";
-
-	bluetooth {
-		compatible = "nxp,88w8987-bt";
-	};
 };
 
 &lpuart2 {
