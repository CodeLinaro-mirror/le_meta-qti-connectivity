From d654eb63a5e7caa63d8b16e105d861c24e926c78 Mon Sep 17 00:00:00 2001
From: Xueqiang Gong <quic_gongx@quicinc.com>
Date: Thu, 23 May 2024 10:54:34 +0800
Subject: [PATCH] update dts to support Hamilton Chip

Upstream-Status: Pending
Signed-off-by: Xueqiang Gong <quic_gongx@quicinc.com>
---
 arch/arm64/boot/dts/freescale/Makefile        |  2 +-
 arch/arm64/boot/dts/freescale/imx8mq.dtsi     |  1 +
 arch/arm64/boot/dts/freescale/imx8qxp-mek.dts |  1 +
 arch/arm64/boot/dts/freescale/qc-cnss.dts     | 57 +++++++++++++++++++
 4 files changed, 60 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/boot/dts/freescale/qc-cnss.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 025a2a8b0739..ba6f05e2c2d5 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -488,7 +488,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-titan-adv7535-ap1302.dtb
 
 imx95-19x19-titan-os08a20-dtbs := imx95-19x19-titan.dtb imx95-19x19-titan-os08a20.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-titan-os08a20.dtb
-
+dtb-$(CONFIG_ARCH_MXC) += qc-cnss.dtb
 dtb-$(CONFIG_ARCH_S32) += s32g274a-evb.dtb
 dtb-$(CONFIG_ARCH_S32) += s32g274a-rdb2.dtb
 dtb-$(CONFIG_ARCH_S32) += s32v234-evb.dtb \
diff --git a/arch/arm64/boot/dts/freescale/imx8mq.dtsi b/arch/arm64/boot/dts/freescale/imx8mq.dtsi
index 3e095e3cba27..ab44cf54445c 100644
--- a/arch/arm64/boot/dts/freescale/imx8mq.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mq.dtsi
@@ -12,6 +12,7 @@
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/thermal/thermal.h>
 #include "imx8mq-pinfunc.h"
+#include "qc-cnss.dts"
 
 / {
 	interrupt-parent = <&gpc>;
diff --git a/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts b/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
index 715a52a5abbe..47cf994059be 100644
--- a/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
+++ b/arch/arm64/boot/dts/freescale/imx8qxp-mek.dts
@@ -7,6 +7,7 @@
 
 #include "imx8qxp.dtsi"
 #include "imx8x-mek.dtsi"
+#include "qc-cnss.dts"
 
 / {
 	model = "Freescale i.MX8QXP MEK";
diff --git a/arch/arm64/boot/dts/freescale/qc-cnss.dts b/arch/arm64/boot/dts/freescale/qc-cnss.dts
new file mode 100644
index 000000000000..c0d712038d22
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/qc-cnss.dts
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Copyright (c) 2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * Copyright (c) 2018-2019, The Linux Foundation. All rights reserved.
+*/
+ / {
+
+	qcom,cnss-qca6390@a0000000 {
+		status = "disabled";
+	};
+
+	cnss_pcie: qcom,cnss-qca-converged {
+		compatible = "qcom,cnss-qca-converged";
+
+		qcom,wlan;
+		qcom,converged-dt;
+		qcom,wlan-rc-num = <1>;
+		qcom,bus-type=<0>;
+		qcom,notify-modem-status;
+		
+		chip_cfg@1 {
+			reg = <0xb0000000 0x10000>;
+			reg-names = "smmu_iova_ipa";
+			supported-ids = <0x1101>;
+			wlan_vregs;
+
+			qcom,wlan-ramdump-dynamic = <0x400000>;
+		};
+
+		chip_cfg@2 {
+			reg = <0xb0000000 0x10000>;
+			reg-names = "smmu_iova_ipa";
+			supported-ids = <0x1102>;
+			wlan_vregs;
+
+			qcom,wlan-ramdump-dynamic = <0x400000>;
+
+		};
+
+		chip_cfg@3 {
+			reg = <0xb0000000 0x10000>;
+			reg-names = "smmu_iova_ipa";
+			supported-ids = <0x1103>;
+			wlan_vregs;
+
+			qcom,wlan-ramdump-dynamic = <0x420000>;
+		};
+
+		chip_cfg@4 {
+			reg = <0xb0000000 0x10000>;
+			reg-names = "smmu_iova_ipa";
+			supported-ids = <0x1107>;
+			wlan_vregs;
+
+			qcom,wlan-ramdump-dynamic = <0x780000>;
+		};		
+	};
+};
-- 
2.34.1

