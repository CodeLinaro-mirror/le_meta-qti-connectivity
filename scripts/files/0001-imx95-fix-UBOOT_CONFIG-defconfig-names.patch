From da1981a35c3f114a6368a5a0d19e779a1b68854c Mon Sep 17 00:00:00 2001
From: Dongyuan Li <dongyuan@qti.qualcomm.com>
Date: Mon, 13 Jul 2026 14:58:19 +0800
Subject: [PATCH] imx95 fix UBOOT_CONFIG defconfig names

Change-Id: Iae8b9a8f184315f630573770c3642596cdc2c009
Signed-off-by: Dongyuan Li <dongyuan@qti.qualcomm.com>
---
 conf/machine/include/imx95-evk.inc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/conf/machine/include/imx95-evk.inc b/conf/machine/include/imx95-evk.inc
index d78745cf..30191429 100644
--- a/conf/machine/include/imx95-evk.inc
+++ b/conf/machine/include/imx95-evk.inc
@@ -18,8 +18,8 @@ UBOOT_MAKE_TARGET = ""
 SPL_BINARY = "spl/u-boot-spl.bin"
 
 UBOOT_CONFIG ??= "sd"
-UBOOT_CONFIG[sd] = "${UBOOT_CONFIG_BASENAME}_evk_defconfig,sdcard"
-UBOOT_CONFIG[fspi] = "${UBOOT_CONFIG_BASENAME}_evk_fspi_defconfig"
+UBOOT_CONFIG[sd] = "${UBOOT_CONFIG_BASENAME}_defconfig,sdcard"
+UBOOT_CONFIG[fspi] = "${UBOOT_CONFIG_BASENAME}_fspi_defconfig"
 
 ATF_PLATFORM = "imx95"
 OEI_CONFIGS = "ddr tcm"
-- 
2.34.1

